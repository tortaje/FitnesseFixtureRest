<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.tortaje</groupId>
  <artifactId>fitnesse-rest</artifactId>
  <version>1.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>fitnesse-rest</name>
  <description>FitNesse Slim fixture: REST client with secret references, auth and OpenTelemetry spans.</description>
  <url>https://github.com/tortaje/FitnesseFixtureRest</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>tortaje</id>
      <name>Stéphane Tortajada</name>
      <url>https://github.com/tortaje</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/tortaje/FitnesseFixtureRest.git</connection>
    <developerConnection>scm:git:https://github.com/tortaje/FitnesseFixtureRest.git</developerConnection>
    <url>https://github.com/tortaje/FitnesseFixtureRest</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/tortaje/FitnesseFixtureRest/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fitnesse.version>20260313</fitnesse.version>
    <fitnesse-hvault.version>1.0.0</fitnesse-hvault.version>
    <fitnesse-otel.version>1.0.0</fitnesse-otel.version>
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <json-path.version>2.10.0</json-path.version>
    <asm.version>9.7.1</asm.version>
    <slf4j.version>2.0.17</slf4j.version>
    <junit.version>5.11.4</junit.version>
    <testcontainers.version>1.20.4</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.fitnesse</groupId>
      <artifactId>fitnesse</artifactId>
      <version>${fitnesse.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.tortaje</groupId>
      <artifactId>fitnesse-hvault</artifactId>
      <version>${fitnesse-hvault.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.tortaje</groupId>
      <artifactId>fitnesse-otel</artifactId>
      <version>${fitnesse-otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>${json-path.version}</version>
    </dependency>
    <!-- pinned to the version accessors-smart declares; otherwise fitnesse's nashorn (provided) mediates it to 7.3.1 -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <version>${opentelemetry.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>vault</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/*SpanTest.java</exclude>
                <exclude>**/*NoHvaultTest.java</exclude>
              </excludes>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <otel.sdk.disabled>true</otel.sdk.disabled>
                <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>span-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*SpanTest.java</include>
              </includes>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
              </systemPropertyVariables>
              <reuseForks>false</reuseForks>
              <forkCount>1</forkCount>
              <failIfNoTests>false</failIfNoTests>
              <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            </configuration>
          </execution>
          <execution>
            <id>no-hvault-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*NoHvaultTest.java</include>
              </includes>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>io.github.tortaje:fitnesse-hvault</classpathDependencyExclude>
                <classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <otel.sdk.disabled>true</otel.sdk.disabled>
                <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
              </systemPropertyVariables>
              <failIfNoTests>false</failIfNoTests>
              <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <artifactSet>
                <includes>
                  <include>com.jayway.jsonpath:json-path</include>
                  <include>net.minidev:json-smart</include>
                  <include>net.minidev:accessors-smart</include>
                  <include>org.ow2.asm:asm</include>
                  <include>org.slf4j:slf4j-api</include>
                  <include>org.slf4j:slf4j-nop</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- identical MIT text to slf4j-api's, which is kept; also covered by THIRD-PARTY-LICENSES.txt -->
                  <artifact>org.slf4j:slf4j-nop</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE.txt</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>com.jayway.jsonpath:json-path</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>net.minidev:json-smart</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>net.minidev:accessors-smart</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>org.ow2.asm:asm</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>org.slf4j:slf4j-api</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- keep only this project's own manifest -->
                  <artifact>org.slf4j:slf4j-nop</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <relocations>
                <relocation>
                  <pattern>com.jayway.jsonpath</pattern>
                  <shadedPattern>io.github.tortaje.rest.shaded.com.jayway.jsonpath</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.minidev</pattern>
                  <shadedPattern>io.github.tortaje.rest.shaded.net.minidev</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.objectweb.asm</pattern>
                  <shadedPattern>io.github.tortaje.rest.shaded.org.objectweb.asm</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>io.github.tortaje.rest.shaded.org.slf4j</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <includes>
            <include>**/PackagedJarIT.java</include>
          </includes>
          <!-- the shaded jar carries its own relocated slf4j-nop; the plain one would clash with fitnesse's JUL provider -->
          <classpathDependencyExcludes>
            <classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
          </classpathDependencyExcludes>
          <systemPropertyVariables>
            <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn verify -Pit: also runs the integration tests that need Docker (real Vault via Testcontainers) -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/PackagedJarIT.java</include>
                <include>**/*VaultIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Everything Maven Central requires: sources, javadoc, GPG signatures, upload to the Central Portal -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- passphrase from the MAVEN_GPG_PASSPHRASE environment variable, or gpg-agent -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- credentials: <server><id>central</id> in ~/.m2/settings.xml, with a Central Portal user token -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- the deployment waits in the Central Portal until it is published by hand -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
